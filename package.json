{
  "name": "cute-obsidian-workbench",
  "version": "0.8.0",
  "description": "A cute dashboard workbench community plugin for Obsidian.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs && node scripts/build-css.mjs",
    "build:release": "npm run build && node scripts/verify-release.mjs",
    "dev": "node scripts/build-css.mjs && node esbuild.config.mjs --watch",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "dashboard",
    "workbench"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.7.3"
  }
}
